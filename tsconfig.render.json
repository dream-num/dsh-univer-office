{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@univer/render-preset": ["./src/viewer-support/render-preset/index.ts"],
      "@univer/render-preset/*": ["./src/viewer-support/render-preset/*"],
      "@univer/importrange-formula": ["./src/viewer-support/importrange-formula/index.ts"]
    }
  },
  "include": ["src/render-machine/**/*.ts", "src/viewer-support/**/*.ts"]
}
