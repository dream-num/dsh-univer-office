{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@univer/collab-gateway-contract": ["./src/gateway-app/contract/index.ts"],
      "@univer/unit-comparison-viewer": ["./packages/unit-comparison-viewer/src/index.ts"],
      "@univer/render-preset": ["./src/viewer-support/render-preset/index.ts"],
      "@univer/render-preset/*": ["./src/viewer-support/render-preset/*"],
      "@univer/importrange-formula": ["./src/viewer-support/importrange-formula/index.ts"]
    }
  },
  "include": [
    "src/viewer-app/**/*.ts",
    "src/viewer-app/**/*.tsx",
    "test/fixtures/**/*.tsx",
    "src/viewer-support/**/*.ts",
    "src/gateway-app/contract/**/*.ts",
    "packages/unit-comparison-viewer/src/**/*.ts",
    "packages/unit-comparison-viewer/src/**/*.tsx"
  ]
}
